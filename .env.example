# Copy to .env and adjust. Every value is optional.

# Browser: chromium | firefox | webkit
KDF_BROWSER=chromium
# Installed browser channel: chrome | msedge | (empty = Playwright's bundled Chromium)
KDF_CHANNEL=chrome
# true = no visible window (use in CI). Google is friendlier to headed runs.
KDF_HEADLESS=false
# Slow every action down (milliseconds) - handy when watching a run
KDF_SLOW_MO_MS=0
# Default timeout for actions and validations (milliseconds)
KDF_TIMEOUT_MS=10000
KDF_NAVIGATION_TIMEOUT_MS=30000
KDF_VIEWPORT=1440x900
KDF_LOCALE=en-US
# Used to resolve relative URLs such as "/login" in the navigate keyword
KDF_BASE_URL=

# Test data: any variable can be read in CSV as ${env.NAME:-default}
# SEARCH_TEXT=Playwright Python
